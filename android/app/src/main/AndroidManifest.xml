<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.totumapp.totum">

    <!-- Accès réseau (Supabase, etc.) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AJOUTER ICI : permission Billing pour Google Play -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Localisation (UV index pour la vitamine D solaire) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Module Respiration : continuité du son procédural écran verrouillé
         (flutter_foreground_task) — FOREGROUND_SERVICE/WAKE_LOCK/
         POST_NOTIFICATIONS sont déjà fusionnées depuis le manifest propre du
         plugin, seule FOREGROUND_SERVICE_MEDIA_PLAYBACK doit être ajoutée
         explicitement (obligatoire Android 14+ pour ce type de service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name="${applicationName}"
        android:label="Totum"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
                <!-- Deep link Supabase / Auth -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- Accepte les URLs com.totumapp.totum://login-callback/... -->
                <data
                    android:scheme="com.totumapp.totum"
                    android:host="login-callback" />
            </intent-filter>

        </activity>

        <!-- 💡 C’EST CETTE LIGNE QUI DIT À FLUTTER : “JE SUIS EN EMBEDDING V2” -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Module Respiration : service au premier plan pour la continuité
             audio écran verrouillé. Nom de classe imposé par le plugin
             flutter_foreground_task, ne pas renommer. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

    </application>

</manifest>
